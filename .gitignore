# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Data: never commit. Regenerate with `uv run beds download` and `uv run beds regenerate`.
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
data/*.duckdb
data/*.duckdb.wal

# Generated outputs (rebuilt by `uv run beds regenerate`)
results/*
!results/.gitkeep
mlruns/
mlartifacts/
submission/
*.zip

# Secrets: never commit
.env
.env.*
*.key

# OS / editors
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
